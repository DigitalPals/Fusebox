<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS by default; allow cleartext for LAN/Tailscale/loopback self-hosted servers when the user enters http:// -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
