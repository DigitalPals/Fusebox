#!/usr/bin/env bash
# Build the Fusebox Android release artifacts:
#   - Sideload APK: android/app/build/outputs/apk/release/
#   - Google Play AAB: android/app/build/outputs/bundle/release/
#
# Usage:
#   android/scripts/build-release [--apk-only] [--play] [--skip-tests] [--version 1.0.2] [--code 3]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APK_ONLY=0
PLAY_STORE=0
SKIP_TESTS=0
VERSION=""
CODE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --apk-only) APK_ONLY=1; shift ;;
    --play) PLAY_STORE=1; shift ;;
    --skip-tests) SKIP_TESTS=1; shift ;;
    --version) VERSION="${2:?--version requires a value}"; shift 2 ;;
    --code) CODE="${2:?--code requires a value}"; shift 2 ;;
    -h|--help)
      sed -n '2,9p' "$0" | sed 's/^# \?//'
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done

export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
if [[ -z "${JAVA_HOME:-}" ]] && command -v mise >/dev/null 2>&1; then
  JAVA_HOME="$(mise where java@temurin-21 2>/dev/null || true)"
  [[ -n "$JAVA_HOME" ]] && export JAVA_HOME
fi

ARGS=()
[[ -n "$VERSION" ]] && ARGS+=("-PfuseboxVersionName=$VERSION")
[[ -n "$CODE" ]] && ARGS+=("-PfuseboxVersionCode=$CODE")
[[ "$PLAY_STORE" -eq 1 ]] && ARGS+=("-PfuseboxPlayStore=true")

TASKS=()
[[ "$SKIP_TESTS" -eq 0 ]] && TASKS+=(testDebugUnitTest)
TASKS+=(assembleRelease)
[[ "$APK_ONLY" -eq 0 ]] && TASKS+=(bundleRelease)

cd "$ROOT"
./gradlew "${TASKS[@]}" "${ARGS[@]}" --console=plain

echo
echo "Built artifacts:"
ls -lh "$ROOT"/app/build/outputs/apk/release/*.apk 2>/dev/null || true
if [[ "$APK_ONLY" -eq 0 ]]; then
  ls -lh "$ROOT"/app/build/outputs/bundle/release/*.aab 2>/dev/null || true
fi
